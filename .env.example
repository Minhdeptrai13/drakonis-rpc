# DISCORD OAUTH2 (Điền thông tin từ Discord Developer Portal)
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# GOOGLE OAUTH2 (Điền thông tin từ Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# FLASK SESSION KEY
SECRET_KEY=generate_a_random_secret_string_here

# CLOUDFLARE TURNSTILE CAPTCHA (FREE 100% UNLIMITED)
# Đăng ký miễn phí tại https://dash.cloudflare.com/ (Turnstile -> Add Site)
# Nếu để trống, hệ thống sẽ tự động dùng Official Cloudflare Test Keys (Always Passes)
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
